# BrightLoop Subscription Management System - Environment Variables Example
# DO NOT COMMIT .env OR REAL SECRETS TO GIT

# Public Supabase Client Config (Browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Secrets (Never expose to client or prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-operations

# Application Demo Config
NEXT_PUBLIC_APP_CURRENCY=₹
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata
